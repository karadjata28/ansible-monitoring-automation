global:
  scrape_interval: {{ prometheus_scrape_interval }}
  evaluation_interval: {{ prometheus_evaluation_interval }}

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets:
          - "localhost:{{ prometheus_web_listen_address.split(':')[-1] }}"

{% if groups.get('node_exporter', []) | length > 0 %}
  - job_name: node_exporter
    static_configs:
{% for host in groups.get('node_exporter', []) %}
      - targets:
          - "{{ hostvars[host].ansible_host | default(host) }}:{{ prometheus_node_exporter_port }}"
        labels:
          host: "{{ host }}"
{% endfor %}
{% endif %}

{% if groups.get('cadvisor', []) | length > 0 %}
  - job_name: cadvisor
    static_configs:
{% for host in groups.get('cadvisor', []) %}
      - targets:
          - "{{ hostvars[host].ansible_host | default(host) }}:{{ prometheus_cadvisor_port }}"
        labels:
          host: "{{ host }}"
{% endfor %}
{% endif %}

{% if groups.get('victorialogs', []) | length > 0 %}
  - job_name: victorialogs
    metrics_path: /metrics
    static_configs:
{% for host in groups.get('victorialogs', []) %}
      - targets:
          - "{{ hostvars[host].ansible_host | default(host) }}:{{ prometheus_victorialogs_port }}"
        labels:
          host: "{{ host }}"
{% endfor %}
{% endif %}

{% if groups.get('vector', []) | length > 0 %}
  - job_name: vector
    metrics_path: /metrics
    static_configs:
{% for host in groups.get('vector', []) %}
      - targets:
          - "{{ hostvars[host].ansible_host | default(host) }}:{{ prometheus_vector_port }}"
        labels:
          host: "{{ host }}"
{% endfor %}
{% endif %}
