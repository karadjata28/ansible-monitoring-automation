[Unit]
Description=VictoriaLogs
Documentation=https://docs.victoriametrics.com/VictoriaLogs/
Wants=network-online.target
After=network-online.target

[Service]
User={{ victorialogs_user }}
Group={{ victorialogs_group }}
ExecStart={{ victorialogs_bin_dir }}/{{ victorialogs_binary_name }} \
  -storageDataPath={{ victorialogs_data_dir }} \
  -httpListenAddr={{ victorialogs_listen_address }}:{{ victorialogs_http_port }} \
  -retentionPeriod={{ victorialogs_retention_period }}{% for arg in victorialogs_extra_args %} \
  {{ arg }}{% endfor %}
WorkingDirectory={{ victorialogs_data_dir }}
Restart=on-failure
RestartSec=2
LimitNOFILE=131072

[Install]
WantedBy=multi-user.target
